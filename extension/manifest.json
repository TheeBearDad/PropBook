{
  "manifest_version": 3,
  "name": "PropBook Sync",
  "version": "2.3.1",
  "description": "Sends what you see on your prop firm dashboards (Lucid, Apex, Tradeify, Vest and others) to the PropBook desktop app, and routes Tradovate CSV exports to it.",
  "permissions": ["storage", "downloads", "alarms", "scripting"],
  "host_permissions": ["http://127.0.0.1:47321/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "*://*.lucidtrading.com/*",
        "*://*.apextraderfunding.com/*",
        "*://*.tradeify.co/*",
        "*://*.topstep.com/*",
        "*://*.topstepx.com/*",
        "*://*.myfundedfutures.com/*",
        "*://*.takeprofittrader.com/*",
        "*://*.bulenox.com/*",
        "*://*.earn2trade.com/*",
        "*://*.tradeday.com/*",
        "*://*.elitetraderfunding.com/*",
        "*://*.vestmarkets.com/*",
        "*://*.vest.exchange/*"
      ],
      "js": ["reader.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PropBook Sync",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
